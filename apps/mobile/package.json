{
    "name": "@pantry-mate/mobile",
    "version": "0.1.0",
    "private": true,
    "license": "UNLICENSED",
    "main": "expo-router/entry",
    "scripts": {
        "android": "expo start --android",
        "ios": "expo start --ios",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "start": "expo start",
        "test": "jest",
        "test:watch": "jest --watch --coverage=false",
        "typecheck": "tsc --noEmit",
        "web": "expo start --web"
    },
    "jest": {
        "collectCoverage": true,
        "collectCoverageFrom": [
            "src/**/*.{ts,tsx}",
            "!src/app/**/_layout.tsx",
            "!src/**/*.test.{ts,tsx}",
            "!src/**/__tests__/**",
            "!**/*.d.ts"
        ],
        "coveragePathIgnorePatterns": [
            "/node_modules/"
        ],
        "coverageThreshold": {
            "./src/**/*.{ts,tsx}": {
                "branches": 100,
                "functions": 100,
                "lines": 100,
                "statements": 100
            }
        },
        "preset": "jest-expo",
        "resetMocks": true,
        "setupFiles": [
            "<rootDir>/src/__tests__/setup.ts"
        ],
        "testEnvironmentOptions": {
            "customExportConditions": [
                "require",
                "react-native",
                "@pantry-mate/source"
            ]
        },
        "testMatch": [
            "**/*.test.[jt]s?(x)"
        ]
    },
    "dependencies": {
        "@expo/ui": "~58.0.27",
        "@pantry-mate/types": "*",
        "expo": "~58.0.23",
        "expo-constants": "~58.0.15",
        "expo-device": "~58.0.5",
        "expo-font": "~58.0.11",
        "expo-glass-effect": "~58.0.5",
        "expo-image": "~58.0.18",
        "expo-linking": "~58.0.16",
        "expo-router": "~58.0.30",
        "expo-splash-screen": "~58.0.13",
        "expo-status-bar": "~58.0.4",
        "expo-symbols": "~58.0.4",
        "expo-system-ui": "~58.0.7",
        "expo-web-browser": "~58.0.7",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-native": "0.88.1",
        "react-native-gesture-handler": "~3.3.0",
        "react-native-reanimated": "4.7.1",
        "react-native-safe-area-context": "~5.11.1",
        "react-native-screens": "~4.30.1",
        "react-native-web": "~0.21.0",
        "react-native-worklets": "0.13.0"
    },
    "devDependencies": {
        "@testing-library/react-native": "^14.1.0",
        "@types/jest": "30.0.0",
        "@types/react": "~19.3.0",
        "jest": "~30.5.2",
        "jest-expo": "~58.0.14",
        "test-renderer": "1.3.0"
    }
}
